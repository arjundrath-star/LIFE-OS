{
  "name": "rathworkspace",
  "version": "1.0.0",
  "private": true,
  "description": "rathworkspace.cloud — personal life-OS command center",
  "scripts": {
    "dev": "tsx watch server.ts",
    "build": "next build",
    "start": "NODE_ENV=production tsx server.ts",
    "lint": "tsc --noEmit",
    "test:agentmemory": "tsx --test tests/agentmemory.test.ts",
    "typecheck": "tsc --noEmit",
    "migrate": "tsx db/index.ts --migrate-only",
    "agent-event": "tsx scripts/agent-event.ts",
    "import-pokemon-crm": "tsx scripts/import-pokemon-crm.ts",
    "import-pokemon-pipeline-crm": "tsx scripts/import-pokemon-pipeline-crm.ts",
    "rerank-pokemon-crm": "tsx scripts/rerank-pokemon-crm.ts",
    "seed:pokemon-ops": "tsx scripts/pokemon-ops-seed.ts",
    "test:pokemon-ops": "tsx --test tests/pokemon-ops.test.ts",
    "test:pokemon-ops-ingest": "tsx --test tests/pokemon-ops-ingest.test.ts",
    "test:pokemon-ops-rules": "tsx --test tests/pokemon-ops-rules.test.ts",
    "test:pokemon-ops-alerts": "tsx --test tests/pokemon-ops-alerts.test.ts",
    "test:pokemon-source-products": "tsx --test tests/pokemon-source-products.test.ts",
    "test:pokemon-benchmark-refresh": "bash agents/pokemon-sourcing-scout/tests/test_pokemon_benchmark_refresh.sh && bash agents/pokemon-sourcing-scout/tests/test_pokemon_benchmark_dispatch.sh",
    "test:business-workspace": "tsx --test tests/business-workspace.test.ts",
    "verify:pokemon-ops": "tsx scripts/verify-pokemon-ops.ts",
    "import:pokemon-ops": "tsx scripts/pokemon-ops-import.ts",
    "smoke:pokemon-ops": "bash scripts/pokemon-ops-smoke.sh",
    "pokemon:alerts": "tsx scripts/pokemon-ops-alerts.ts",
    "pokemon:ingest": "tsx scripts/pokemon-sourcing-ingest.ts",
    "pokemon:source-products": "tsx scripts/pokemon-source-products-refresh.ts",
    "e2e:pokemon-ops": "tsx scripts/pokemon-ops-e2e.ts",
    "e2e:vending-service": "tsx scripts/vending-service-e2e.ts"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-dropdown-menu": "^2.1.4",
    "@radix-ui/react-slot": "^1.1.1",
    "@radix-ui/react-switch": "^1.1.2",
    "@radix-ui/react-tabs": "^1.1.2",
    "@radix-ui/react-tooltip": "^1.1.6",
    "@tremor/react": "^3.18.7",
    "better-sqlite3": "^11.8.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^11.18.0",
    "http-proxy": "^1.18.1",
    "lucide-react": "^0.469.0",
    "next": "^15.1.6",
    "next-auth": "^4.24.11",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.6.0",
    "tsx": "^4.19.2",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/http-proxy": "^1.17.17",
    "@types/node": "^22.10.7",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/ws": "^8.5.13",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.1",
    "puppeteer-core": "^25.3.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3"
  }
}
